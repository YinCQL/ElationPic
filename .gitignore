# ==========================================================================
# ElationPic — .gitignore
#
# 原则：**运行时生成的、含个人信息的、体积大的，都不进版本库。**
# 本文件按项目实际技术栈编写，不是通用模板。
#
# 技术栈：PHP 8.0（无 Composer 依赖）+ Nginx/Apache + SQLite
#        开发环境：Windows + phpstudy
# ==========================================================================

# --------------------------------------------------------------------------
# 1. 运行时配置（★ 最重要）
#
# data/config.php 由安装向导生成，内含管理员密码哈希。
# 它一旦进入版本库就很难真正清除（历史里仍在）。
# 仓库中只提供 data/config.sample.php 作为模板。
# --------------------------------------------------------------------------
data/config.php
data/config.local.php

# 导入备份时自动生成的配置回滚点（含当时的密码哈希）
data/config.before-import-*.php

# --------------------------------------------------------------------------
# 2. 数据库（SQLite 单文件 + WAL 边车文件）
#
# 数据库是"用户数据"，不属于源码。
# 程序首次运行会自动建库建表，无需提交。
# --------------------------------------------------------------------------
data/database.sqlite
data/database.sqlite-wal
data/database.sqlite-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# 导入备份时自动生成的数据库回滚点
data/database.before-import-*.sqlite

# --------------------------------------------------------------------------
# 3. 日志 / 会话 / 临时文件
#
# 日志可能含访问来源与错误细节；会话文件等同登录凭证。
# --------------------------------------------------------------------------
data/logs/*
!data/logs/.gitkeep
data/sessions/*
!data/sessions/.gitkeep
data/tmp/*
!data/tmp/.gitkeep

# --------------------------------------------------------------------------
# 4. 用户上传的图片（★ 绝不能进版本库）
#
# public/uploads/ 是使用者自己的内容，与项目源码无关。
# 目录本身要保留（用 .gitkeep），所以只忽略里面的文件。
# --------------------------------------------------------------------------
public/uploads/*
!public/uploads/.gitkeep
public/uploads/thumbs/*
!public/uploads/thumbs/.gitkeep

# --------------------------------------------------------------------------
# 5. 备份输出
#
# 命令行备份与网页导出的 zip 含数据库、配置（密码哈希）与原图，
# 是整站钥匙，绝不能提交。
# --------------------------------------------------------------------------
backup/*
!backup/.gitkeep
dist/
*.zip

# --------------------------------------------------------------------------
# 6. 测试生成的素材与结果
#
# make-fixtures.php 会生成约 22 MB 的造数据文件（含超大文件），
# 属于可再生的构建产物，不提交；需要时运行生成器即可。
# 测试运行过程中写入的 .txt 结果是临时产物。
# --------------------------------------------------------------------------
tests/fixtures/big.jpg
tests/fixtures/big_filler.bin

# 测试探针与结果文件（__xxx.php / 各类 .txt）
tests/__*
tests/*.txt
public/__*

# 审计过程截图（由人工产生，非项目资产）
tests/shots/

# --------------------------------------------------------------------------
# 7. 本地开发环境
# --------------------------------------------------------------------------

# phpstudy / 其他本地环境可能在该目录留下临时文件
.phpstudy*
*.local.php

# php.ini 与 nginx 配置的本地副本（仓库中只保留 deploy/ 下的模板）
/php.ini
/nginx.conf

# --------------------------------------------------------------------------
# 8. IDE / 编辑器
# --------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
nbproject/

# --------------------------------------------------------------------------
# 9. 操作系统
# --------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# --------------------------------------------------------------------------
# 10. Composer（本项目当前不使用，但保留以防将来引入）
# --------------------------------------------------------------------------
/vendor/
composer.lock

# --------------------------------------------------------------------------
# 11. 多 Agent 协作工具产生的本地状态
# --------------------------------------------------------------------------
.agent-teams/

# --------------------------------------------------------------------------
# 12. 杂项
# --------------------------------------------------------------------------
*.log
!data/logs/.gitkeep
*.bak
*.orig
*.rej
